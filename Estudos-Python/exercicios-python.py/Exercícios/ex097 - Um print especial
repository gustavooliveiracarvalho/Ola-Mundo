('''Faça um programa que tenha uma função
cjamada escreva(), que receba um texto qualquer como parâmetro
e mostre uma mensagem com tamanho adaptável.''') 

def escreva(msg):
    tam = len(msg) + 4
    print(f'-' * tam)
    print(f'  {msg}')
    print(f'-' * tam)
    
    
#Programa principal
escreva('Gustavo Guanabara')
escreva('Curso de Python no YouTube')
escreva('CeV')