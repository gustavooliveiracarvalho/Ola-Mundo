('''Crie um programa que tenha a função leiaint(), que vai funcionar
de forma semelhante à função input() do Python, só que fazendo a validação para
aceitar apenas um valor númerico.''')

def leiaint(msg):
    ok = False
    valor = 0
    while True:
        n = str(input(msg))
        if n.isnumeric():
            valor = int(n)
            ok = True
        else:
            print('\033[0;31mErro! Digite um número inteiro válido.\33[m')
        if ok:
            break
    return valor

#Programa principal
n = leiaint('Digite um número inteiro: ')
print(f'Você acabou de digitar o número inteiro {n}.')