#EXEMPLO PRÁTICO:
def fatorial(num=1):
    f = 1
    for c in range(num, 0, -1):
        f *= c
    return f

#Programa principal
f1 = fatorial(5)
f2 = fatorial(4)
f3 = fatorial()
