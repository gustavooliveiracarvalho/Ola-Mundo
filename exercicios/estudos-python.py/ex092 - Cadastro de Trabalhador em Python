('''Crie um programa que leia nome, ano de nascimento e carteira de trabalho e cadastre-os (cm idade)
em um dicionário, se por acaso a CTPS for diferente de ZERO, o dicionário receberá também o ano de contratação e o salário.
Calcule e acrescente, além da idade, com quantos anos a pessoa vai se aposentar.''')

from datetime import datetime
cadastro = {}

print('-' * 30)
print('CADASTRO DE TRABALHADOR')
print('-' * 30)

cadastro['Nome'] = str(input('Nome: '))
cadastro['Ano de nascimento'] = int(input('Ano de nascimento: '))
cadastro['CTPS'] = int(input('Carteira de trabalho (0 se nenhuma): '))
cadastro['Idade'] = datetime.now().year - cadastro['Ano de nascimento']

if cadastro['CTPS'] != 0:

    cadastro['Ano de contratação'] = int(input('Ano de contratação: '))
    cadastro['Salário'] = float(input('Salário: R$'))
    cadastro['Aposentadoria'] = cadastro['Idade'] + ((cadastro['Ano de contratação'] + 35) - datetime.now().year)

print('-' * 30)
print('DADOS DO TRABALHADOR')
print('-' * 30)

for k, v in cadastro.items():
    print(f'{k} tem o valor {v}.')