#EMPACOTAMENTO DE PARAMETROS:
#Usamos enpacotamento para que a função leia uma quantidade variada de dados dentro do parâmetro.
#Para isso é utilizado o "*", por exemplo: *num - isso significa que eu não sei quantos parâmetros eu vou receber, então, preciso que ele receba quantos eu quiser.
def contador (*num):
    for valor in num:
        print(f'{valor} ', end='')
    print('FIM!')


contador(2, 1, 7)
contador(8, 0)
contador(4, 4, 7, 6, 2)

lin()
