#Trabalhando com Listas ao invés de Tuplas:
#Vou fazer uma def que dobre os valores dentro de uma lista. 
def dobra(lst):
    pos = 0
    while pos < len(lst):
        lst[pos] *= 2
        pos +=1


valores = [6, 3, 9, 1, 0, 2]
dobra(valores)
print(valores)