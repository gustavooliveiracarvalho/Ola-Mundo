('''faça um programa que tenha uma função chamada maior(),
que receba vários parâmetros com valores inteiros. Seu
programa tem que analisar todos os valores e dizer qual deles 
é maior.''')

from time import sleep
def linha():
    print('-' * 30)
def espacamento():
    print()

def maior(*num):
    maior = cont = 0
    linha()
    print('Analisando os valores passados...')
    linha()
    for valor in num:
        print(f'{valor} ', end=' ', flush=True)
        sleep(0.3)
        if cont == 0:
            maior = valor
        else:
            if valor > maior:
                maior = valor
        cont +=1
    espacamento()
    linha()
    print(f'Foram informados {cont} valores ao todo.')
    print(f'O maior valor informado foi {maior}.')
#Programa principal
maior(2, 9, 4, 5, 7, 1)
maior(4, 7, 0)
maior(1,2)
maior(6)
maior(0)